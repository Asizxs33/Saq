{
  "name": "saq-guardian",
  "version": "1.0.0",
  "description": "SAQ Guardian — фоновая защита от финансовых пирамид",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win portable"
  },
  "devDependencies": {
    "@electron/packager": "^20.1.1",
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "dependencies": {
    "active-win": "^8.2.1",
    "tesseract.js": "^5.1.1"
  },
  "build": {
    "appId": "kz.saq.guardian",
    "productName": "SAQ Guardian",
    "npmRebuild": false,
    "win": {
      "target": "portable",
      "icon": "assets/icon.ico"
    },
    "asarUnpack": [
      "node_modules/tesseract.js/**",
      "node_modules/tesseract.js-core/**"
    ]
  }
}
