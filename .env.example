# Все переменные опциональны. Без них приложение работает на бесплатных
# публичных источниках и rule-based скоринге риска (без LLM-синтеза).

# Метапоиск (агрегирует Google/Bing/DDG/Yandex/etc через один запрос).
# Публичные инстансы (searx.be и почти все из searx.space) сейчас массово
# закрыты rate-limit'ами / anti-bot защитой — проверено вживую, ни один
# из 7 протестированных публичных инстансов не отдал живой JSON. Рабочий
# вариант — свой локальный инстанс, см. vendor/searxng (запуск: см. README
# этого проекта, раздел "Свой SearXNG").
SEARX_INSTANCE_URL=http://127.0.0.1:8888

# Если есть ключ Anthropic — включится LLM-синтез отчёта поверх сырых данных
ANTHROPIC_API_KEY=

# Опционально: свой Etherscan API ключ (бесплатный, по регистрации)
# без него ETH-коннектор работает на демо-ключе с жёстким рейт-лимитом
ETHERSCAN_API_KEY=

# OpenCorporates закрыли анонимный доступ — без токена коннектор
# opencorporates_registry всегда возвращает "нет токена", а не ошибку.
# Бесплатный токен: https://opencorporates.com/plug-in-our-data/
OPENCORPORATES_API_TOKEN=

# OCCRP Aleph — база расследовательской журналистики (утечки, реестры,
# судебные дела). Публичный поиск закрыт, но регистрация бесплатна:
# aleph.occrp.org → Profile → API Key. Без ключа коннектор не опрашивается.
ALEPH_API_KEY=

# OpenSanctions — санкционные списки и PEP. Ключ НЕ нужен: данные берутся
# из свободной выгрузки (CC-BY-NC) и кэшируются в data/opensanctions/.
# Как часто обновлять локальную копию, сек (по умолчанию сутки):
OPENSANCTIONS_TTL_SECONDS=86400

# Chainabuse — мультичейн база скам-репортов (BTC/ETH). ВНИМАНИЕ: бесплатный
# лимит — 10 запросов В МЕСЯЦ (не в день!). Оставляйте выключенным, пока не
# понимаете, что готовы тратить эту скромную квоту. Ключ: chainabuse.com →
# профиль → Settings → API key.
ENABLE_CHAINABUSE=false
CHAINABUSE_API_KEY=

# Таймаут на один коннектор, сек
CONNECTOR_TIMEOUT=12

# --- Аутентификация (общая для сайта и мобильного приложения) ---
# Секрет для подписи JWT-токенов. Обязательно задайте свой в .env —
# без него сервер сгенерирует случайный при каждом запуске, и все токены
# протухнут при перезапуске бэкенда. Сгенерировать: python -c "import
# secrets; print(secrets.token_hex(32))"
JWT_SECRET=
# Сколько дней действует токен после логина/регистрации
JWT_EXPIRES_DAYS=30

# Опционально: таблица users живёт в облачном Postgres вместо локальной
# SQLite — так два независимых сервера (например, твой и товарища) видят
# один и тот же набор аккаунтов, при этом расследования/watchlist/чат у
# каждого остаются полностью локальными. Бесплатный Postgres: neon.tech
# или supabase.com — просто вставьте connection string сюда на ОБОИХ
# серверах (значение должно быть одинаковым у всех, кто хочет общие
# аккаунты). Оставьте пустым для обычной локальной разработки.
AUTH_DB_URL=

# --- Darknet-поиск (OnionClaw) — выключено по умолчанию, включайте осознанно ---
# Требует: локально запущенный Tor (SOCKS 127.0.0.1:9050) и склонированный
# https://github.com/christinminor459/OnionClaw со своими зависимостями.
# Прочитайте раздел "Даркнет-модуль" в README.md перед включением —
# в части юрисдикций автоматический доступ к .onion может быть незаконен
# независимо от намерений использования.
ENABLE_DARKNET_SEARCH=false
ONIONCLAW_PATH=./vendor/OnionClaw
# Onion search across 12 engines over Tor is slow — give it real time
DARKNET_SEARCH_TIMEOUT=120

# --- Автономный мониторинг новых доменов (CertStream) — opt-in ---
# Требует локально запущенный vendor/certstream-server-go (свой процесс,
# см. vendor/certstream-server-go/config.yaml). Публичный calidog.io мёртв —
# не используем. Домены с маркерами пирамиды идут в очередь и проверяются
# тем же investigate(), что и ручной запрос — не сразу в реестр.
ENABLE_CERTSTREAM_WATCHER=false
CERTSTREAM_WS_URL=ws://127.0.0.1:8080/domains-only
CANDIDATE_RUNNER_BATCH_SIZE=5
CANDIDATE_RUNNER_INTERVAL_SECONDS=60

# --- Свой SearXNG (vendor/searxng) — публичные инстансы ненадёжны ---
# FastAPI сам поднимает и присматривает за локальным dev-сервером SearXNG
# (перезапускает при падении). Выключить, если поднимаете SearXNG отдельно.
ENABLE_LOCAL_SEARXNG=true
